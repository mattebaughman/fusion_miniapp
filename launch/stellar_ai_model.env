# The model servers' settings for fusion's StellarAI runs: NVIDIA Nemotron 3.5 Lightning (NVFP4) on vLLM, one
# server per B200, started by AUTONMI's jobs/model.sh. AUTONMI's jobs/local.env on StellarAI sources this file
# (add the line `source "$FUSION_MINIAPP_DIR/launch/stellar_ai_model.env"` as its last line), so the values stay
# under version control here. It sets RASCAL_MODEL and RASCAL_VENV whatever local.env set before it, so the
# placeholders of AUTONMI's local.env.example do not win. It is sourced on the login node, on the campaign node and
# on each model node, under `set -u`: every value it reads from the environment has a default or a clear error.
# It holds no secret: the servers' key is a file the launch script writes (FLEET_DIR/api-key), never a variable
# here.
#
#   FUSION_SCRATCH     your GPFS scratch directory (the model's weights, the caches, the run folders)
#   FUSION_ENV         the campaign's Python 3.12 venv (AUTONMI, Flowgentic 0.6.0 and this package)
#   FUSION_VLLM_ENV    the vLLM 0.27.1 environment (default: $FUSION_SCRATCH/envs/vllm)
#   FUSION_MODEL_PATH  the model's weights (default: $FUSION_SCRATCH/models/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4)
#
# Configured, not yet run on the machine: that vLLM accepts each flag below (repeated flags take their last
# value, so these override model.sh's own --gpu-memory-utilization 0.9 and --enable-prefix-caching) is checked
# when the first model server starts.

# The model. RASCAL_MODEL_NAME must equal llm.model in knobs/machines/stellar_ai_nemotron.yaml: the run checks
# every server's /v1/models for it before any campaign.
RASCAL_MODEL=${FUSION_MODEL_PATH:-${FUSION_SCRATCH:?set FUSION_SCRATCH}/models/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4}
RASCAL_MODEL_NAME=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
RASCAL_TOOL_PARSER=qwen3_coder   # NVIDIA's pairing for Nemotron 3; no call of this package uses tools
# RASCAL_REASONING=nemotron_v3   # only with llm.thinking on and the thinking budget sent; thinking is off here
RASCAL_VLLM_RESTARTS=3           # a server that dies is started again up to 3 times; then the model job ends

# vLLM's serving flags, appended to model.sh's own (it expands them unquoted, so the JSON has no spaces):
# - TRITON_ATTN: the default FlashInfer attention does not start with an FP8 KV cache offline;
# - an FP8 KV cache (the checkpoint's own), no prefix caching (on this hybrid Mamba model it doubles each
#   request's fixed state), 92% of GPU memory, and a 16-bit Mamba state with stochastic rounding;
# - at most 4,096 requests running per server, 32,768 batched tokens, asynchronous scheduling;
# - CUDA graphs captured for batches of up to 4,096 requests.
# model.sh keeps its --max-model-len 32768, --host 0.0.0.0 and the key in VLLM_API_KEY.
RASCAL_VLLM_ARGS="--attention-backend TRITON_ATTN --kv-cache-dtype fp8 --no-enable-prefix-caching \
--gpu-memory-utilization 0.92 --mamba-ssm-cache-dtype float16 --enable-mamba-cache-stochastic-rounding \
--mamba-cache-philox-rounds 5 --max-num-seqs 4096 --max-num-batched-tokens 32768 --async-scheduling \
--compilation-config={\"cudagraph_mode\":\"FULL_AND_PIECEWISE\",\"cudagraph_capture_sizes\":\
[1,2,4,8,16,32,64,128,256,512,768,1024,1536,2048,2560,3072,3584,4096]}"

# Python: model.sh activates RASCAL_VENV (the campaign venv: it runs python for the key and the ports), and
# finds vllm in the vLLM environment, put on PATH here.
RASCAL_VENV=${FUSION_ENV:?set FUSION_ENV}
RASCAL_CUDART=
PATH="${FUSION_VLLM_ENV:-$FUSION_SCRATCH/envs/vllm}/bin:$PATH"

# Compute nodes have no internet and no nvcc: no network probes, no kernels built at run time, caches on scratch.
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 FLASHINFER_DISABLE_JIT=1 VLLM_USE_FLASHINFER_SAMPLER=0 PYTHONUNBUFFERED=1
export HF_HOME=$FUSION_SCRATCH/hf VLLM_CACHE_ROOT=$FUSION_SCRATCH/vllm_cache XDG_CACHE_HOME=$FUSION_SCRATCH/xdg_cache
export TRITON_CACHE_DIR=$FUSION_SCRATCH/triton_cache FLASHINFER_WORKSPACE_BASE=$FUSION_SCRATCH/flashinfer_cache
export PIP_CACHE_DIR=$FUSION_SCRATCH/pip_cache CONDA_PKGS_DIRS=$FUSION_SCRATCH/conda_pkgs   # for building the envs
export TMPDIR=/tmp   # node-local: StellarAI gives each job its own /tmp (unverified on the node)
